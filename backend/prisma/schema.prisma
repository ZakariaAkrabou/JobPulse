// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
enum RoleName {
  client
  admin
}

model Role {
  id    BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name  RoleName @unique

  users User[]

  @@map("roles")
}

enum JobType {
  full_time
  part_time
  contract
  internship
  freelance
}

enum WorkMode {
  remote
  onsite
  hybrid
}

enum DateRange {
  h24
  d7
  d30
  any
}

model User {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)

  roleId BigInt @map("role_id") @db.UnsignedBigInt
  role   Role   @relation(fields: [roleId], references: [id])

  isVerified Boolean @default(false) @map("is_verified")

  verificationToken          String?   @map("verification_token") @db.VarChar(255)
  verificationTokenExpiresAt DateTime? @map("verification_token_expires_at")

  resetPasswordToken          String?   @map("reset_password_token") @db.VarChar(255)
  resetPasswordTokenExpiresAt DateTime? @map("reset_password_token_expires_at")

  refreshToken          String?   @map("refresh_token") @db.VarChar(500)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")

  profile UserProfile?
  preferences UserJobPreferences?
  selectedPublishers UserSelectedPublisher[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model UserProfile {
  id     BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId BigInt @unique @map("user_id") @db.UnsignedBigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone          String? @db.VarChar(30)
  location       String? @db.VarChar(150)
  currentTitle   String? @map("current_title") @db.VarChar(150)
  experienceYears Int?   @map("experience_years") @db.UnsignedTinyInt
  summary        String? @db.Text

  resumeUrl        String? @map("resume_url") @db.VarChar(500)
  resumeParsedText String? @map("resume_parsed_text") @db.LongText
  resumeParsedJson Json?   @map("resume_parsed_json")

  @@map("user_profiles")
}

model UserJobPreferences {
  id     BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId BigInt @unique @map("user_id") @db.UnsignedBigInt
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobType        JobType?   @map("job_type")
  workMode       WorkMode?  @map("work_mode")
  dateRange      DateRange? @map("date_range")
  keywords       String?    @db.VarChar(255)
  locationFilter String?    @map("location_filter") @db.VarChar(150)
  salaryMin      Int?       @map("salary_min")
  currency       String?    @db.VarChar(3)

  @@map("user_job_preferences")
}


model Job {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  externalId      String   @map("external_id") @db.VarChar(255)
  jobApiId        BigInt   @map("job_api_id") @db.UnsignedBigInt
  jobPublisherId  BigInt?  @map("job_publisher_id") @db.UnsignedBigInt

  title       String  @db.VarChar(255)
  company     String  @db.VarChar(255)
  location    String? @db.VarChar(255)
  description String? @db.LongText
  url         String  @db.VarChar(500)

  salaryMin Int?    @map("salary_min")
  salaryMax Int?    @map("salary_max")
  currency  String? @db.VarChar(3)

  jobType    String? @map("job_type") @db.VarChar(50)
  workMode   String? @map("work_mode") @db.VarChar(50)

  postedAt  DateTime? @map("posted_at")
  fetchedAt DateTime  @default(now()) @map("fetched_at")

  jobApi       JobApi        @relation(fields: [jobApiId], references: [id])
  jobPublisher JobPublisher? @relation(fields: [jobPublisherId], references: [id])

  @@unique([externalId, jobApiId])
  @@index([postedAt])
  @@index([jobApiId])
  @@index([jobPublisherId])
  @@map("jobs")
}

model JobApi {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String   @unique @db.VarChar(50)
  name        String   @unique @db.VarChar(100)
  apiEndpoint String   @map("api_endpoint") @db.VarChar(500)
  apiKeyEnv   String   @map("api_key_env") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  discoveredPublishers JobPublisher[]
  jobs                 Job[]

  @@map("job_apis")
}
model JobPublisher {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  name          String   @unique @db.VarChar(100)
  slug          String   @unique @db.VarChar(50)
  discoveredVia BigInt?  @map("discovered_via") @db.UnsignedBigInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  discoveredViaApi JobApi?                @relation(fields: [discoveredVia], references: [id], onDelete: SetNull)
  userSelections   UserSelectedPublisher[]
  jobs             Job[]

  @@map("job_publishers")
}

model UserSelectedPublisher {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt   @map("user_id") @db.UnsignedBigInt
  publisherId BigInt   @map("publisher_id") @db.UnsignedBigInt
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publisher JobPublisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@unique([userId, publisherId])
  @@map("user_selected_publishers")
}